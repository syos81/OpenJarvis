{
  "bindings": [
    {
      "binding_id": "baseline-errata",
      "call_style": "root_relative",
      "expectation": "accepted",
      "kind": "callable",
      "loader": "tools.gates.errata:load_document",
      "pattern": "config/governance/baseline-errata.json",
      "reason": "The errata document has a real reader that validates the envelope and every erratum, including the digest binding to the frozen document."
    },
    {
      "binding_id": "block-manifest",
      "call_style": "path",
      "expectation": "accepted",
      "kind": "callable",
      "loader": "tools.gates.manifest:load",
      "pattern": "config/gates/blocks/*.json",
      "reason": "Block manifests are validated by the manifest engine, which is the only reader that decides phases, checks and results."
    },
    {
      "binding_id": "config-loader-bindings",
      "expectation": "accepted",
      "kind": "structural",
      "optional_fields": [],
      "pattern": "config/governance/config-loaders.json",
      "reason": "The binding document declares its own reader too. R4 has no exception for itself.",
      "required_fields": [
        "bindings",
        "coverage_roots",
        "kind",
        "rule",
        "schema_version",
        "statement"
      ]
    },
    {
      "binding_id": "feature-lineage",
      "expectation": "accepted",
      "kind": "structural",
      "optional_fields": [],
      "pattern": "config/gates/features/*.lineage.json",
      "reason": "Feature lineage documents. The field set is the reader for the completeness comparison against the immediate predecessor.",
      "required_fields": [
        "artifact_id",
        "artifact_version",
        "features",
        "predecessor_artifact_id",
        "predecessor_feature_list_sha256",
        "schema_version"
      ]
    },
    {
      "binding_id": "feature-predecessor",
      "expectation": "accepted",
      "kind": "structural",
      "optional_fields": [],
      "pattern": "config/gates/features/*.predecessor.json",
      "reason": "Predecessor feature list. Same reader family as the lineage, without the lineage binding fields.",
      "required_fields": [
        "artifact_id",
        "artifact_version",
        "features"
      ]
    },
    {
      "binding_id": "gate-evidence",
      "expectation": "accepted",
      "kind": "structural",
      "optional_fields": [],
      "pattern": "config/gates/evidence/**/*.json",
      "reason": "Committed, PII checked snapshots of historical gate evidence. The declared field set is the accepting reader; the evidence itself is never re-executed.",
      "required_fields": [
        "baseline_commit",
        "block",
        "cache_state",
        "cause_signature_digest",
        "check_ids",
        "commit",
        "engine_version",
        "finished_at",
        "manifest_digest",
        "phase",
        "platform_class",
        "raw_log_sha256",
        "reason_codes",
        "run_id",
        "schema_version",
        "started_at",
        "status"
      ]
    },
    {
      "binding_id": "generality-contract",
      "expectation": "accepted",
      "kind": "structural",
      "optional_fields": [],
      "pattern": "config/governance/generality-fixtures/contract.json",
      "reason": "The generality contract fixture.",
      "required_fields": [
        "activation_source",
        "contract_id",
        "fixtures",
        "mechanism_test",
        "must_not_require",
        "must_prove",
        "note",
        "schema_version"
