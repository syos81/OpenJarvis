      "expectation": "accepted",
      "kind": "callable",
      "loader": "tools.gates.astscan:load_register",
      "pattern": "config/governance/ast-dispositions.json",
      "reason": "The R9/R10 disposition register is read exclusively by the scan validator, which rejects unknown fields, unknown candidate classes, lazy reasons and contradictory resolutions before any comparison runs."
    },
