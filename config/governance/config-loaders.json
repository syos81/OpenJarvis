      "loader": "tools.gates.manifest:load",
      "pattern": "config/gates/fixtures/manifests/invalid/*.json",
      "reason": "Declared fixture: a manifest the engine must reject. A loader that accepts one of these is broken, so the expectation is inverted on purpose."
    },
