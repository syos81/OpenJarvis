  "engine_min_version": "1.0.0",
  "evidence_policy": {
    "raw_log_area": "runtime_only",
    "sanitized_evidence": true
  },
  "feature_lineage": {
    "lineage_file": "config/gates/features/b0d-guard-hardening.lineage.json",
    "own_expected": 43,
    "own_prefix": "B0D-",
    "predecessor_file": "config/gates/features/b0c-governance.lineage.json"
  },
  "phase_definitions": {
    "module-final": {
      "applicable": true,
      "reason": "Aggregates the phase results, the sanitised evidence and the feature completeness against the immediate predecessor B0c.",
      "required": true
    },
    "offline-final": {
      "applicable": true,
      "reason": "Evaluates everything the block asserts without a network, without a provider and without a present owner. Only the manipulation matrix and the collection tool write, and only into throwaway directories below the declared fixture root inside the gitignored runtime area.",
      "required": true
    },
    "platform-live": {
      "applicable": true,
      "reason": "The live regression of the active owner installed guard, plus the determination of the activation state. It reports the relation between the candidate package and the active installation and requires no particular version: activation is the consequence of acceptance, not its condition.",
      "required": true
    },
    "preflight": {
      "applicable": true,
      "reason": "Checks the prerequisites: worktree and branch, baseline commit, tools, platform, this manifest, the guard base, the trust model, the candidate package, and \u2014 before anything reads a configuration \u2014 that every configuration is loaded by its declared reader and every owner expectation value is derived from the commit it names.",
      "required": true
    },
    "targeted": {
      "applicable": true,
      "reason": "The block has an incremental change set of its own: the collection tool, the manipulation matrix, rule R9, the recording path and the historical object record each have a check that can run on its own during the work.",
      "required": true
    }
  },
  "platform_requirements": {
    "architectures": [
      "x86_64"
    ],
    "min_python": "3.10",
    "systems": [
      "Darwin"
    ]
  },
  "product_guard": {
    "allowed_paths": [
      "*"
    ],
    "block_base_commit": "d037cb67502ab7fdcef95161bdbf2857181d0354",
    "forbidden_paths": []
  },
  "required_phases": [
    "preflight",
    "targeted",
    "offline-final",
    "platform-live",
    "module-final"
  ],
  "schema_version": 1,
  "targeted_selection": {
    "always": [
      "tg-claim-lint",
      "tg-collect-tool",
      "tg-config-loaders",
      "tg-effect-evidence",
      "tg-guard-tests",
      "tg-historical-objects",
      "tg-manipulation-matrix",
      "tg-observed-wiring",
      "tg-owner-expectations",
      "tg-rule-changes"
    ],
    "base_ref": "f3dd0f48b2896acc6df789f4ae775021a924cda8",
    "rules": [
      {
        "checks": [
          "tg-manipulation-matrix",
          "tg-observed-wiring",
          "tg-guard-tests",
          "tg-rule-changes"
        ],
        "paths": [
          "tools/guard/*",
          "tools/guardpkg/*"
        ],
        "rule_id": "r-guard-runtime"
      },
      {
        "checks": [
          "tg-collect-tool",
          "tg-observed-wiring"
        ],
        "paths": [
          "tools/guardops/*",
          "scripts/guard-collect.sh",
          "scripts/guard-install.sh"
        ],
        "rule_id": "r-owner-tooling"
      },
      {
        "checks": [
          "tg-config-loaders",
          "tg-historical-objects",
          "tg-owner-expectations"
        ],
        "paths": [
          "config/*"
        ],
        "rule_id": "r-configuration"
      },
      {
        "checks": [
          "tg-effect-evidence",
          "tg-guard-tests"
        ],
        "paths": [
          "tests/*"
        ],
        "rule_id": "r-tests"
      }
    ]
  },
  "title": "B0d guard hardening: exception qualification, the owner collection tool, the manipulation matrix and rule R9"
