{
  "schema_version": 1,
  "block_id": "b0a-1-tooling",
  "title": "B0a-1 deterministic gate, baseline and evidence tooling",
  "engine_min_version": "1.0.0",
  "required_phases": [
    "preflight",
    "targeted",
    "offline-final",
    "platform-live",
    "module-final"
  ],
  "phase_definitions": {
    "preflight": {
      "applicable": true,
      "required": true,
      "reason": "Checks only the prerequisites of the block: manifest, tools, worktree, branch, working tree state, local commit objects, platform and non-secret configuration."
    },
    "targeted": {
      "applicable": true,
      "required": true,
      "reason": "Runs the limited checks that the declared change rules select for the current diff."
    },
    "offline-final": {
      "applicable": true,
      "required": true,
      "reason": "Runs every reproducible offline check of the block; no network, TCC, provider or production access is required."
    },
    "platform-live": {
      "applicable": false,
      "required": true,
      "declared_result": "not_applicable",
      "reason": "B0a-1 is a pure tooling block: it contains no product code, starts no provider and performs no platform or live acceptance. There is no mandatory live check whose prerequisite could be missing, therefore the phase is declared non-applicable rather than blocked."
    },
    "module-final": {
      "applicable": true,
      "required": true,
      "reason": "Aggregates the complete closing state of the block: commit reference, manifest and engine version, evidence completeness, feature completeness, working tree state and forbidden product changes."
    }
  },
  "targeted_selection": {
    "base_ref": "d037cb67502ab7fdcef95161bdbf2857181d0354",
    "always": ["tg-static-scan"],
    "rules": [
