      },
      {
        "rule_id": "r-hook",
        "paths": [
          "tools/gates/hookguard.py",
          ".claude/hooks/*.sh",
          ".claude/settings.json"
        ],
        "checks": ["tg-hook-tests"]
      },
      {
        "rule_id": "r-manifest",
        "paths": [
          "tools/gates/manifest.py",
          "config/gates/blocks/*.json",
          "config/gates/fixtures/manifests/*.json"
        ],
        "checks": ["tg-manifest-tests"]
      },
      {
        "rule_id": "r-runners",
        "paths": ["tools/gates/runners/*.py", "tools/gates/gitutil.py"],
        "checks": ["tg-cli-tests", "tg-static-scan"]
      },
      {
        "rule_id": "r-tests",
        "paths": ["tests/tooling/gates/*.py"],
        "checks": [
          "tg-aggregation-tests",
          "tg-baseline-tests",
          "tg-cache-tests",
          "tg-cli-tests",
          "tg-evidence-tests",
          "tg-feature-tests",
          "tg-hook-tests",
