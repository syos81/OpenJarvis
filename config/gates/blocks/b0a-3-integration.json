{
  "schema_version": 1,
  "block_id": "b0a-3-integration",
  "title": "B0a-3 decision collision resolution and tooling integration",
  "engine_min_version": "1.0.0",
  "required_phases": [
    "preflight",
    "targeted",
    "offline-final",
    "platform-live",
    "module-final"
  ],
  "phase_definitions": {
    "preflight": {
      "applicable": true,
      "required": true,
      "reason": "Checks the prerequisites of the integration: worktree and target branch, tools, platform, manifest, mechanically derived guard base and the non-secret integration configuration."
    },
    "targeted": {
      "applicable": true,
      "required": true,
      "reason": "Runs the checks that the fixed renumbering and the reference migration require for the current change set."
    },
    "offline-final": {
      "applicable": true,
      "required": true,
      "reason": "Runs every reproducible offline check of the integration including the complete test suite; no network, TCC, provider or production access is required."
    },
    "platform-live": {
      "applicable": false,
      "required": true,
      "declared_result": "not_applicable",
      "reason": "B0a-3 is a pure integration, governance and tooling block. No productive platform function, no native identity and no domain module function was changed; the block renumbers decision ids, migrates their references and merges the gate tooling. There is therefore no mandatory live check whose prerequisite could be missing."
    },
    "module-final": {
      "applicable": true,
      "required": true,
      "reason": "Aggregates the closing state: merge topology, integration diff, feature completeness and evidence."
    }
  },
  "targeted_selection": {
    "base_ref": "d037cb67502ab7fdcef95161bdbf2857181d0354",
    "always": [
      "tg-collisions-closed",
      "tg-id-mapping",
      "tg-reference-migration"
    ],
    "rules": [
      {
        "rule_id": "r-decisions",
        "paths": [
          "docs/adr/*.md",
          "docs/personal-jarvis/decisions-register.md",
          "config/governance/b0a-3-id-migration.json"
        ],
        "checks": [
          "tg-collisions-closed",
          "tg-id-mapping",
          "tg-reference-migration",
          "tg-single-normative-source"
        ]
      },
      {
        "rule_id": "r-governance",
        "paths": [
          "config/governance/*.json",
          "docs/governance/*.md",
          "docs/personal-jarvis/calendar-implementation-baseline-2026-08-04.md"
        ],
        "checks": [
          "tg-governance-tests",
          "tg-single-normative-source"
        ]
      },
      {
        "rule_id": "r-generality",
        "paths": [
          "config/governance/generality-scope.json",
          "tools/gates/generality.py"
        ],
        "checks": [
          "tg-bundle-id-pinned",
          "tg-dart-removed",
          "tg-generality-tests"
        ]
      },
      {
        "rule_id": "r-identity",
        "paths": [
          "src/personaljarvis/**",
          "native/contacts-bridge/**",
          "frontend/src-tauri/**"
        ],
        "checks": [
          "tg-no-identity-change"
        ]
      },
      {
        "rule_id": "r-merge",
        "paths": [
          "tools/gates/runners/integration_checks.py"
        ],
        "checks": [
          "tg-merge-topology",
          "tg-no-identity-change"
        ]
      }
    ]
  },
