{
  "schema_version": 1,
  "block_id": "b0e-test-hardening",
  "title": "B0e test hardening: the derived executable corpus, the R9 and R10 syntax tree sweeps and the disposition register",
  "engine_min_version": "1.0.0",
  "required_phases": [
    "preflight",
    "targeted",
    "offline-final",
    "platform-live",
    "module-final"
  ],
  "phase_definitions": {
    "preflight": {
      "applicable": true,
      "required": true,
      "reason": "Worktree, branch, platform, tools, the R4 loader bindings, the trust model, the guard base and the non-empty derived corpus are prerequisites of every later phase."
    },
    "targeted": {
      "applicable": true,
      "required": true,
      "reason": "During the work the sweeps, the disposition coverage, the effect evidence regression and the rule change discipline are checked against the current change."
    },
    "offline-final": {
      "applicable": true,
      "required": true,
      "reason": "The full reproducible acceptance: corpus derivation, both sweeps against the committed register, the complete tooling test suite and every governance check, without any owner action."
    },
    "platform-live": {
      "applicable": false,
      "required": true,
      "declared_result": "not_applicable",
      "reason": "Derived from the block's own obligations, not assumed: the block's change set against its targeted base 3e90d675a3dce38348cc0fcf1556f8a68dd14031 contains no path under tools/guard, tools/guardpkg, tools/guardops or src (recorded as a diff-emptiness statement in the acceptance evidence), so the installed guard, the guard package and every live component are unchanged and no new candidate exists whose live acceptance could be pending. The active installation itself stays verified by pf-guard-base in every run. There is no live obligation whose prerequisite could be missing."
    },
    "module-final": {
      "applicable": true,
      "required": true,
      "reason": "Closing aggregation over stored phase results, evidence completeness, feature lineage and preservation."
    }
  },
  "targeted_selection": {
    "base_ref": "3e90d675a3dce38348cc0fcf1556f8a68dd14031",
    "always": [
      "tg-claim-lint",
      "tg-config-loaders",
      "tg-corpus",
      "tg-dispositions",
      "tg-effect-evidence",
      "tg-rule-changes",
      "tg-scan-tests",
      "tg-violation-corpus"
    ],
    "rules": [
      {
        "rule_id": "r-scanner",
        "paths": [
          "tools/gates/*"
        ],
        "checks": [
          "tg-corpus",
          "tg-dispositions",
          "tg-scan-tests"
        ]
      },
      {
        "rule_id": "r-tests",
        "paths": [
          "tests/*"
        ],
        "checks": [
          "tg-dispositions",
          "tg-effect-evidence",
          "tg-scan-tests"
        ]
      },
      {
        "rule_id": "r-configuration",
        "paths": [
          "config/*"
        ],
        "checks": [
          "tg-config-loaders",
          "tg-dispositions",
          "tg-rule-changes"
        ]
      }
    ]
  },
