{
  "schema_version": 1,
  "block_id": "b0a-2-governance",
  "title": "B0a-2 decision register, module map and governance gates",
  "engine_min_version": "1.0.0",
  "required_phases": [
    "preflight",
    "targeted",
    "offline-final",
    "platform-live",
    "module-final"
  ],
  "phase_definitions": {
    "preflight": {
      "applicable": true,
      "required": true,
      "reason": "Checks only the prerequisites: manifest, tools, worktree, branch, working tree state, local commit objects, platform and the non-secret governance configuration."
    },
    "targeted": {
      "applicable": true,
      "required": true,
      "reason": "Runs the limited governance and generality checks that the declared change rules select for the current diff."
    },
    "offline-final": {
      "applicable": true,
      "required": true,
      "reason": "Runs every reproducible offline check of the governance block including the B0a-1 regression; no network, TCC, provider or production access is required."
    },
    "platform-live": {
      "applicable": false,
      "required": true,
      "declared_result": "not_applicable",
      "reason": "B0a-2 is a pure governance block: it contains no product code, starts no provider and performs no platform or live acceptance. There is no mandatory live check whose prerequisite could be missing, therefore the phase is declared non-applicable rather than blocked."
    },
    "module-final": {
      "applicable": true,
      "required": true,
      "reason": "Aggregates the closing state and re-verifies the complete B0a-1 tooling as unchanged and functional."
    }
  },
  "targeted_selection": {
    "base_ref": "d037cb67502ab7fdcef95161bdbf2857181d0354",
    "always": [
      "tg-collisions",
      "tg-order"
    ],
    "rules": [
      {
        "rule_id": "r-generality",
        "paths": [
          "tools/gates/generality.py",
          "config/governance/generality-scope.json",
          "config/governance/generality-fixtures/*.json"
        ],
        "checks": [
          "tg-generality-tests"
        ]
      },
      {
        "rule_id": "r-governance",
        "paths": [
          "tools/gates/governance.py",
          "config/governance/*.json",
          "docs/governance/*.md"
        ],
        "checks": [
          "tg-collisions",
          "tg-governance-tests",
          "tg-order"
        ]
      },
      {
        "rule_id": "r-guard-base",
        "paths": [
          "tools/gates/guardbase.py",
          "tools/gates/runners/repo_guard.py"
        ],
        "checks": [
          "tg-guard-base-tests"
        ]
      },
      {
        "rule_id": "r-hygiene",
        "paths": [
          "tools/gates/hygiene.py",
          ".gitignore",
          ".claude/settings.json"
        ],
        "checks": [
          "tg-hygiene-tests"
        ]
      },
      {
        "rule_id": "r-runners",
        "paths": [
          "tools/gates/runners/*.py"
        ],
        "checks": [
          "tg-generality-tests",
          "tg-governance-tests",
          "tg-guard-base-tests",
          "tg-hygiene-tests"
        ]
      },
      {
        "rule_id": "r-tests",
        "paths": [
          "tests/tooling/gates/*.py"
        ],
        "checks": [
          "tg-generality-tests",
          "tg-governance-tests",
          "tg-guard-base-tests",
          "tg-hygiene-tests"
        ]
      }
    ]
  },
