{
  "schema_version": 1,
  "block_id": "b0b-calendar-k1",
  "title": "B0b calendar K1 offline work and tool boundary sharpening",
  "engine_min_version": "1.0.0",
  "required_phases": [
    "preflight",
    "targeted",
    "offline-final",
    "platform-live",
    "module-final"
  ],
  "phase_definitions": {
    "preflight": {
      "applicable": true,
      "required": true,
      "reason": "Prerequisites: worktree and branch, tools, platform, manifest, guard base, the derived K1 definition and the guard trust model."
    },
    "targeted": {
      "applicable": true,
      "required": true,
      "reason": "The checks the tool sharpening and the K1 work need on the current change set."
    },
    "offline-final": {
      "applicable": true,
      "required": true,
      "reason": "Every reproducible offline check including both complete test suites, the closing K1 matrix, the historical integrity of B0a-1 to B0a-4 and the current preservation manifest."
    },
    "platform-live": {
      "applicable": true,
      "required": true,
      "reason": "The guard package changed and was reactivated by the owner, so the live regression of the active guard is mandatory. This phase covers the guard only. The platform dependent K1 gates are carried as open K1 gates inside the evidence and are deliberately not disguised as a not_applicable phase."
    },
    "module-final": {
      "applicable": true,
      "required": true,
      "reason": "Aggregates the closing state: feature completeness, preservation, the K1 matrix, phase results and evidence."
    }
  },
  "targeted_selection": {
    "base_ref": "a1adabf20884b7c350a439a0e8023e4b38f2b910",
    "always": [
      "tg-calendar-tests",
      "tg-claim-lint",
      "tg-classification-schemes",
      "tg-gate-anchoring",
      "tg-k1-definition",
      "tg-not-applicable-review",
      "tg-pii-tests",
      "tg-rule-changes",
      "tg-violation-corpus"
    ],
    "rules": [
      {
        "rule_id": "r-calendar",
        "paths": [
          "src/personaljarvis/calendar/*",
          "tests/personal/calendar/*"
        ],
        "checks": [
          "tg-calendar-tests"
        ]
      },
      {
        "rule_id": "r-pii",
        "paths": [
          "tools/guard/*",
          "tools/gates/*"
        ],
        "checks": [
          "tg-pii-tests",
          "tg-rule-changes",
          "tg-violation-corpus"
        ]
      },
      {
        "rule_id": "r-k1",
        "paths": [
          "config/gates/k1/*"
        ],
        "checks": [
          "tg-k1-definition",
          "tg-classification-schemes"
        ]
      }
    ]
  },
