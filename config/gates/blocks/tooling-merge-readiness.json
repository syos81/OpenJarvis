{
  "schema_version": 1,
  "block_id": "tooling-merge-readiness",
  "title": "Readiness of the single narrowly bounded later tooling integration",
  "engine_min_version": "1.0.0",
  "required_phases": [
    "preflight",
    "targeted",
    "offline-final",
    "platform-live",
    "module-final"
  ],
  "phase_definitions": {
    "preflight": {
      "applicable": true,
      "required": true,
      "reason": "Checks the prerequisites of the readiness statement: the intended source and target line and the declared absence of any merge execution."
    },
    "targeted": {
      "applicable": false,
      "required": false,
      "declared_result": "not_applicable",
      "reason": "The readiness manifest has no incremental change set of its own; it always evaluates the complete incoming difference in offline-final."
    },
    "offline-final": {
      "applicable": true,
      "required": true,
      "reason": "Evaluates the complete incoming difference, the required module closing gates, the feature lists and the sanitized evidence — read only."
    },
    "platform-live": {
      "applicable": false,
      "required": true,
      "declared_result": "not_applicable",
      "reason": "Readiness is decided from repository facts alone. No platform, provider or live system is involved, therefore the phase is declared non-applicable rather than blocked."
    },
    "module-final": {
      "applicable": true,
      "required": true,
      "reason": "Aggregates the readiness statement. It never performs the integration; the merge itself stays an owner action outside every block."
    }
  },
  "targeted_selection": {
    "base_ref": "d037cb67502ab7fdcef95161bdbf2857181d0354",
    "always": [
      "pf-merge-refs"
    ],
    "rules": []
  },
  "checks": [
