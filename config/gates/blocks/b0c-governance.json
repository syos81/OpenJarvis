{
  "schema_version": 1,
  "block_id": "b0c-governance",
  "title": "B0c governance: configuration binding, target bound release, reservation register, acceptance profiles",
  "engine_min_version": "1.0.0",
  "required_phases": [
    "preflight",
    "targeted",
    "offline-final",
    "platform-live",
    "module-final"
  ],
  "phase_definitions": {
    "preflight": {
      "applicable": true,
      "required": true,
      "reason": "Checks the prerequisites: worktree and branch, baseline commit, tools, platform, the manifest itself, the guard base, the trust model, and \u2014 before anything reads a configuration \u2014 that every configuration is loaded by its declared reader."
    },
    "targeted": {
      "applicable": true,
      "required": true,
      "reason": "The block has an incremental change set of its own: the configuration binding, the target bound release, the register, the profile derivation and the errata layer each have a check that can run on its own during the work."
    },
    "offline-final": {
      "applicable": true,
      "required": true,
      "reason": "Evaluates everything the block asserts without a network, without a provider and without a present owner. The register model runs against a throwaway bare repository below the declared fixture root; nothing else writes."
    },
    "platform-live": {
      "applicable": true,
      "required": true,
      "reason": "The live regression of the active owner installed guard, plus the determination of the activation state. It reports the relation between the candidate package and the active installation and requires no particular version: activation is the consequence of acceptance, not its condition."
    },
    "module-final": {
      "applicable": true,
      "required": true,
      "reason": "Aggregates the phase results, the evidence and the feature completeness against the immediate predecessor. It performs no owner action."
    }
  },
  "targeted_selection": {
    "base_ref": "06b7d7e3740325a12c4b1a2c41d3192e4f696c14",
    "always": [
      "tg-claim-lint",
      "tg-classification-schemes",
      "tg-config-loaders",
      "tg-errata",
      "tg-fixture-rule",
      "tg-governance-tests",
      "tg-not-applicable-review",
      "tg-pii-tests",
      "tg-profile-derivation",
      "tg-profile-lock",
      "tg-rule-changes",
      "tg-scanner-method",
      "tg-violation-corpus"
    ],
    "rules": [
      {
        "rule_id": "r-guard",
        "paths": [
          "tools/guard/*",
          "tools/guardpkg/*",
          "config/guard/*"
        ],
        "checks": [
          "tg-fixture-rule",
          "tg-rule-changes",
          "tg-violation-corpus"
        ]
      },
      {
        "rule_id": "r-register",
        "paths": [
          "tools/decreg/*",
          "scripts/dec-reservations.sh"
        ],
        "checks": [
          "tg-scanner-method",
          "tg-governance-tests"
        ]
      },
      {
        "rule_id": "r-configuration",
        "paths": [
          "config/*"
        ],
        "checks": [
          "tg-config-loaders",
          "tg-errata",
          "tg-profile-derivation"
        ]
      }
    ]
  },
