{
  "schema_version": 1,
  "block_id": "b0a-4-guard",
  "title": "B0a-4 fail closed guard bootstrap and B0b starting state",
  "engine_min_version": "1.0.0",
  "required_phases": [
    "preflight",
    "targeted",
    "offline-final",
    "platform-live",
    "module-final"
  ],
  "phase_definitions": {
    "preflight": {
      "applicable": true,
      "required": true,
      "reason": "Checks the prerequisites: worktree and target branch, tools, platform, manifest, mechanically derived guard base, the unchanged published B0a-3 commit, the declared commit plan and the declared variant assessment."
    },
    "targeted": {
      "applicable": true,
      "required": true,
      "reason": "Runs the checks the guard rewrite needs on the current change set before the owner activation."
    },
    "offline-final": {
      "applicable": true,
      "required": true,
      "reason": "Runs every reproducible offline check including both complete test suites, the tamper and parser tests, package hash reproducibility, the historical integrity of B0a-1 to B0a-3 and the current preservation manifest."
    },
    "platform-live": {
      "applicable": true,
      "required": true,
      "reason": "The protection effect of an externally installed guard cannot be shown offline. This phase verifies the active installation, the protected hook registration, the real decision matrix in the calendar worktree and in a worktree without tooling, and that the guarded session cannot change the chain."
    },
    "module-final": {
      "applicable": true,
      "required": true,
      "reason": "Aggregates the closing state: feature completeness, preservation, commit plan, phase results and evidence."
    }
  },
  "targeted_selection": {
    "base_ref": "a0936877254c092bc75314b8078dedeb1deccc7a",
    "always": [
      "tg-errata",
      "tg-fail-closed-paths",
      "tg-guard-tests",
      "tg-history-matrix",
      "tg-hook-tests",
      "tg-no-worktree-fallback",
      "tg-owner-activation",
      "tg-package-determinism",
      "tg-rule-changes",
      "tg-violation-corpus"
    ],
    "rules": [
      {
        "rule_id": "r-guard",
        "paths": [
          "tools/guard/*",
          "tools/guardpkg/*"
        ],
        "checks": [
          "tg-guard-tests",
          "tg-hook-tests",
          "tg-package-determinism",
          "tg-history-matrix"
        ]
      },
      {
        "rule_id": "r-owner-helpers",
        "paths": [
          "scripts/guard-install.sh",
          "scripts/guard-exception.sh"
        ],
        "checks": [
          "tg-owner-activation"
        ]
      },
      {
        "rule_id": "r-errata",
        "paths": [
          "docs/governance/*"
        ],
        "checks": [
          "tg-errata"
        ]
      },
      {
        "rule_id": "r-hook",
        "paths": [
          ".claude/hooks/*",
          "tools/gates/hookguard.py"
        ],
        "checks": [
          "tg-hook-tests",
          "tg-fail-closed-paths"
        ]
      }
    ]
  },
