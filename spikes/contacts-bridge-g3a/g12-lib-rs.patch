+    // keine Tauri-Runtime, kein Backend und kein Fenster gestartet.
+    #[cfg(target_os = "macos")]
+    if std::env::var("JARVIS_CONTACTS_SPIKE_G12").as_deref() == Ok("1") {
+        std::process::exit(spike_g12_handshake());
+    }
+
