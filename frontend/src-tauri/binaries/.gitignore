# Sidecar binaries — platform-specific, never committed.
# `ollama-*` is downloaded (scripts/download-ollama.sh);
# `jarvis-contacts-*` is built from native/contacts-bridge/
# (scripts/build-contacts-sidecar.sh, ADR-0016).
ollama-*
jarvis-contacts-*
# `contacts-write-helper-*` ist der opferbare Schreibhelfer
# (cargo --bin contacts-write-helper, ADR-0020-Nachtrag 2026-08-04).
contacts-write-helper-*
# `jarvis-calendar-*` wird aus native/calendar-bridge/ gebaut
# (scripts/build-calendar-sidecar.sh, Modul 2).
jarvis-calendar-*
!.gitignore
